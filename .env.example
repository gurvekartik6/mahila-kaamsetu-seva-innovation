# Local Express API
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (local PostgreSQL or Neon)
# Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/mahila_db
# Neon example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_STRICT=true

# Sessions
SESSION_DAYS=7
PG_POOL_MAX=5

# Required for encrypted private document storage. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY=

# Admin bootstrap only: used by `npm run admin:create`; never expose in frontend.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=KaamSetu Administrator

# Python LangGraph service URL. Local development default:
AI_SERVICE_URL=http://127.0.0.1:8000

# Gemini credentials belong ONLY in ai-service/.env or the AI host's secret settings.
# Do not put GEMINI_API_KEY in this root file or any VITE_* variable.

# Optional public contact address used by the website Contact form (Vite build-time variable)
VITE_CONTACT_EMAIL=
